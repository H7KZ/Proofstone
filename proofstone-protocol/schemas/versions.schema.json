{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofstone.dev/schemas/versions.schema.json",
  "title": "Proofstone version matrix (versions.yml)",
  "description": "Spec: docs/specs/versions-yml.md. Decision: ADR-0008. Semantic rules live in build-logic (validateVersions).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "java-rules", "drivers", "platforms"],
  "properties": {
    "schema": { "enum": [2, 3] },
    "java-rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["range", "image"],
        "properties": {
          "range": { "type": "string", "minLength": 1 },
          "image": { "$ref": "#/$defs/javaImage" }
        }
      }
    },
    "drivers": {
      "type": "object",
      "additionalProperties": { "type": "object", "minProperties": 1 }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/platform" }
    },
    "proxies": {
      "description": "Schema 3 (ADR-0016): proxy platforms and the backend rows they are paired with. Semantic rules live in VersionsCatalog.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/proxy" }
    }
  },
  "$defs": {
    "javaImage": { "type": "string", "pattern": "^java[0-9]+$" },
    "status": { "enum": ["required", "experimental", "retired"] },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "rows"],
      "properties": {
        "builder": { "$ref": "#/$defs/builder" },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "digests"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "digests": {
              "description": "Image digest by Java tag (ADR-0013). TODO until pinned.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/javaImage" },
              "additionalProperties": {
                "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]+$" }, { "const": "TODO" }]
              }
            }
          }
        },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "forwarding", "rows"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "digests"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "digests": {
              "description": "Image digest by Java tag (ADR-0013). TODO until pinned.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/javaImage" },
              "additionalProperties": {
                "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]+$" }, { "const": "TODO" }]
              }
            }
          }
        },
        "forwarding": { "enum": ["modern", "legacy"] },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/proxyRow" } }
      }
    },
    "proxyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "sha256", "java", "status", "backends"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "build": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "const": "TODO" }] },
        "sha256": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "const": "TODO" }] },
        "java": { "$ref": "#/$defs/javaImage" },
        "status": { "$ref": "#/$defs/status" },
        "backends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "mc", "status"],
            "properties": {
              "platform": { "type": "string", "minLength": 1 },
              "mc": { "type": "string", "minLength": 1 },
              "status": { "$ref": "#/$defs/status" }
            }
          }
        },
        "observed": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "builder": {
      "description": "How the server jar is built from source (Spigot, T-M5-05). Rows then need no build number.",
      "type": "object",
      "additionalProperties": false,
      "required": ["buildtools", "jdk"],
      "properties": {
        "buildtools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["build", "sha256"],
          "properties": {
            "build": { "type": "integer", "minimum": 1 },
            "sha256": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "const": "TODO" }] }
          }
        },
        "jdk": {
          "description": "JDK image by Java tag, pinned by digest (ADR-0013). TODO until pinned.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/javaImage" },
          "additionalProperties": {
            "anyOf": [{ "type": "string", "pattern": "^[a-z0-9./-]+@sha256:[0-9a-f]{64}$" }, { "const": "TODO" }]
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mc", "sha256", "status"],
      "properties": {
        "mc": { "type": "string", "minLength": 1 },
        "build": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "const": "TODO" }] },
        "sha256": { "type": "string", "minLength": 1 },
        "java": { "$ref": "#/$defs/javaImage" },
        "protocol": { "type": "integer" },
        "status": { "$ref": "#/$defs/status" },
        "native-drivers": { "type": "array", "items": { "type": "string" } },
        "observed": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
