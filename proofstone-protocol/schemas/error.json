{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofstone.dev/schemas/error.json",
  "title": "Error body",
  "description": "Spec: docs/specs/agent-protocol.md §1. The code is an UPPER_SNAKE token such as UNKNOWN_KEY or TIMEOUT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string" },
    "detail": {}
  }
}
